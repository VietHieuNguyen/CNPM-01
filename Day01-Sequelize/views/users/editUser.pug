doctype html
html
  head
    title Edit User
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous")
  body.bg-light
    .container.py-4
      .d-flex.justify-content-between.align-items-center.mb-4
        div
          h2.mb-1 Edit user
          p.text-muted.mb-0 Update basic user information.
        a.btn.btn-outline-secondary(href="/get-crud") Back

      .card.shadow-sm.border-0
        .card-body
          form(action="/put-crud" method="POST")
            input(type="hidden" id="id" name="id" value=data.id)
            .row.g-3
              .col-md-6
                label.form-label(for="email") Email
                input.form-control(type="email" id="email" value=data.email readonly)
              .col-md-6
                label.form-label(for="phoneNumber") Phone number
                input.form-control(type="text" id="phoneNumber" name="phoneNumber" value=data.phoneNumber)
              .col-md-6
                label.form-label(for="firstName") First name
                input.form-control(type="text" id="firstName" name="firstName" value=data.firstName required)
              .col-md-6
                label.form-label(for="lastName") Last name
                input.form-control(type="text" id="lastName" name="lastName" value=data.lastName required)
              .col-12
                label.form-label(for="address") Address
                input.form-control(type="text" id="address" name="address" value=data.address)
            .mt-4.d-flex.gap-2
              button.btn.btn-primary(type="submit") Save changes
              a.btn.btn-light(href="/get-crud") Cancel
