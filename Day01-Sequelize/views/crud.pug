doctype html
html
  head
    title Create User
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous")
  body.bg-light
    .container.py-4
      .d-flex.justify-content-between.align-items-center.mb-4
        div
          h2.mb-1 Create user
          p.text-muted.mb-0 Add a new user account.
        a.btn.btn-outline-secondary(href="/get-crud") View users

      .card.shadow-sm.border-0
        .card-body
          form(action="/post-crud" method="POST")
            .row.g-3
              .col-md-6
                label.form-label(for="email") Email
                input.form-control(type="email" id="email" name="email" required)
              .col-md-6
                label.form-label(for="password") Password
                input.form-control(type="password" id="password" name="password" required)
              .col-md-6
                label.form-label(for="firstName") First name
                input.form-control(type="text" id="firstName" name="firstName" required)
              .col-md-6
                label.form-label(for="lastName") Last name
                input.form-control(type="text" id="lastName" name="lastName" required)
              .col-md-6
                label.form-label(for="phoneNumber") Phone number
                input.form-control(type="text" id="phoneNumber" name="phoneNumber")
              .col-md-6
                label.form-label(for="address") Address
                input.form-control(type="text" id="address" name="address")
              .col-md-6
                label.form-label(for="gender") Gender
                select.form-select(id="gender" name="gender")
                  option(selected value="0") Male
                  option(value="1") Female
              .col-md-6
                label.form-label(for="roleId") Role
                select.form-select(id="roleId" name="roleId")
                  option(selected value="1") Admin
                  option(value="2") Doctor
                  option(value="3") Patient
            .mt-4.d-flex.gap-2
              button.btn.btn-primary(type="submit") Create
              a.btn.btn-light(href="/") Cancel
