doctype html
html
  head
    title User List
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous")
  body.bg-light
    .container.py-4
      .d-flex.justify-content-between.align-items-center.mb-4
        div
          h2.mb-1 Users
          p.text-muted.mb-0 Manage created users.
        a.btn.btn-primary(href="/crud") Add user

      .card.shadow-sm.border-0
        .card-body
          if dataList && dataList.length
            .table-responsive
              table.table.table-hover.align-middle.mb-0
                thead.table-light
                  tr
                    th(scope="col") Email
                    th(scope="col") First name
                    th(scope="col") Last name
                    th(scope="col") Phone
                    th(scope="col") Address
                    th.text-end(scope="col") Action
                tbody
                  each item in dataList
                    tr
                      td #{item.email}
                      td #{item.firstName}
                      td #{item.lastName}
                      td #{item.phoneNumber || ""}
                      td #{item.address || ""}
                      td.text-end
                        a.btn.btn-sm.btn-outline-primary.me-2(href=`/edit-crud?id=${item.id}`) Edit
                        a.btn.btn-sm.btn-outline-danger(href=`/delete-crud?id=${item.id}` onclick="return confirm('Delete this user?')") Delete
          else
            .alert.alert-info.mb-0 No users yet.
